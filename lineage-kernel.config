# Keep SMBIOS available to the kernel without exporting desktop DMI IDs to Android apps.
# CONFIG_DMIID is not set

# CDH: 用户态 /vendor/、/vendor_dlkm/ -> /patch/vendor/、/patch/vendor_dlkm/ 路径重定向（内置，开机即生效）
CONFIG_CDH_PATH_REDIRECT=y

# CDH: pioneer 域（guest 值守 daemon + 其 adb shell/sync 子进程）内核强制 permissive。
# 本盘 init 内嵌 secilc 不支持 CIL permissive 语句，策略侧无法自声明；permissive_map
# 置位后所有以 pioneer 为主体的 AVC 判定放行（审计保留），策略段无需再逐条枚举。
CONFIG_CDH_PIONEER_PERMISSIVE=y

# ashmem：上游 android16 是 Rust 实现（Kconfig: depends on SHMEM && RUST），而本构建的
# builder 镜像缺 bindgen，内核 rust_is_available.sh 判定失败 → CONFIG_RUST 被剔除 →
# ASHMEM 连带被剔除 → 无 /dev/ashmem → MIUI A16 的 system_server 建共享内存失败
# （RuntimeException: Failed to create ashmem: ENOENT）→ 每 5s 崩一次，boot_completed 不置位。
# 内核树已改为 note13-5G-15 同款 C 实现（drivers/staging/android/ashmem.c，Kconfig 去掉 RUST），
# 此处显式开启。
CONFIG_ASHMEM=y

# 软件 RTC（rtc-test）：VM 里必须有一个 RTC class 设备，否则 alarmtimer 拿不到 rtcdev，
# timer_create(CLOCK_BOOTTIME_ALARM) 直接返回 EOPNOTSUPP（kernel/time/alarmtimer.c
# alarm_timer_create: !alarmtimer_get_rtcdev() → -EOPNOTSUPP）。
# 成因：UEFI(edk2)+ACPI 引导时 QEMU 不生成 RTC 的 ACPI 设备
# （qemu/hw/arm/virt-acpi-build.c: "we won't generate the RTC ACPI device at all when
#  using UEFI"），且 ARM 侧 pl031 无 ACPI 驱动、EFI stub 又给出空 DTB（日志
# "EFI stub: Generating empty DTB"）→ 内核无任何 RTC 设备。
# 后果：MIUI A16 的 MiSensorServiceImpl::SensorEventToOneTrack 建 alarm timer 失败后仍调
# timer_settime → SIGSEGV，system_server 每 62s 崩一次（实测 20 次全同一栈），boot_completed
# 永不置位。
# rtc-test 的 init 会自行注册平台设备，read_time 取系统时钟（不会把时间设成 2000），
# 并带 hrtimer 闹钟，足以满足 alarmtimer。
CONFIG_RTC_DRV_TEST=y

# virtio-gpu：darwin 的 QEMU cgl-headless 显示后端只支持 dumb/2D scanout
# （实测内核报 ctrl 0x208 RESOURCE_CREATE_BLOB / 0x209 SET_SCANOUT_BLOB →
#  RESP_ERR_INVALID_RESOURCE_ID），而 MIUI A16 的 SurfaceFlinger 优先走 blob →
# scanout 全失败、VNC 停在旧帧（画面卡在开机动画）。本项让驱动不向用户态宣告
# blob 能力，强制回退 2D scanout；virgl(GL) 渲染不依赖 blob。
CONFIG_CDH_VIRTGPU_NO_BLOB=y

# v7：mac80211_hwsim —— 真无线（wlan0 station + wlan1 AP radio，netns 隔离），
# 消除 virt_wifi 的以太网 backing（buried_eth1），使 App 可见接口对齐真机。
# 放此项目层 config（merge_config 顺序最后）而非内核源树，避免 git commit。
CONFIG_MAC80211=m
CONFIG_MAC80211_HWSIM=m
# mac80211.ko 加载报 Unknown symbol arc4_setkey/arc4_crypt：arc4 lib 必须内建
CONFIG_CRYPTO_LIB_ARC4=y
